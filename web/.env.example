# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon public" / publishable anahtar
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" / secret anahtar — GİZLİ

# Android köprü uygulamasının kullanacağı uzun rastgele anahtar (kendin üret)
SYNC_TOKEN=

# İsteğe bağlı: ücretsiz anahtarlar (boşsa USDA için DEMO_KEY kullanılır)
USDA_API_KEY=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
